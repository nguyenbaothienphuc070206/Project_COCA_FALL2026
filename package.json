{
  "name": "ai-studio-applet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:node",
    "test:node": "npx --yes tsx --test src/lib/verification.test.ts src/lib/phase4.test.ts src/lib/phase5.test.ts src/lib/phase6.contract.test.ts src/lib/phase7.security.test.ts src/lib/phase8.completeness.test.ts src/lib/phase9.seo.test.ts",
    "e2e": "playwright test",
    "audit": "npm audit --audit-level=high",
    "clean": "next clean",
    "security:check": "npx --yes tsx --test src/lib/phase7.security.test.ts"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "@types/three": "^0.187.0",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "helmet": "^8.3.0",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "postcss": "^8.5.23",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.3.1",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "4.1.11",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "firebase-tools": "^15.0.0",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "postcss-selector-parser": "^6.1.5",
    "uuid": "^11.1.1"
  }
}
