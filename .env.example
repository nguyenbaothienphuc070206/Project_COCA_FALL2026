# ============================================================================
# ShelfPath Production & Development Environment Configuration (.env.example)
# ============================================================================

# NODE_ENV: Set to "production" in Cloud Run deployments ("development" locally).
NODE_ENV="production"

# PORT: Port the HTTP server listens on (Cloud Run injects PORT automatically, default: 3000).
PORT="3000"

# SITE_URL: Canonical base URL used for <link rel="canonical">, hreflang alternates,
# OpenGraph URLs, Twitter cards, JSON-LD structured data, robots.txt, and sitemap.xml.
SITE_URL="https://shelfpath.example.org"

# APP_URL: Alias fallback for SITE_URL in AI Studio environments.
APP_URL="https://shelfpath.example.org"

# GEMINI_API_KEY: Required in production when MOCK_MODE="false" (server-side secret only).
# Configure via the Secrets panel in Google AI Studio or Cloud Run Secret Manager.
# Server fails fast at startup in production (MOCK_MODE="false") if this secret is missing.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Model used for query understanding, search grounding, extraction, and explanations.
GEMINI_MODEL="gemini-3.8-flash"

# GEMINI_EMBEDDING_MODEL: Model used for multilingual semantic ranking.
GEMINI_EMBEDDING_MODEL="gemini-embedding-2-preview"

# GOOGLE_BOOKS_API_KEY: API key for Google Books /books/v1/volumes secondary verification & metadata enrichment.
# Configure via the Secrets panel in Google AI Studio.
GOOGLE_BOOKS_API_KEY=""

# OPENLIBRARY_CONTACT_EMAIL: Contact email sent in Open Library User-Agent header ("ShelfPath (<email>)")
# to unlock the 3 req/s polite rate limit tier (falls back to 1 req/s when empty).
OPENLIBRARY_CONTACT_EMAIL=""

# MOCK_MODE: Set to "false" in production for live catalog verification pipeline,
# or "true" for deterministic pre-verified sample datasets without external API calls.
MOCK_MODE="false"

# EVAL_ENABLED: Set to "false" in production to disable /eval and /api/eval/* routes.
EVAL_ENABLED="false"

# EVAL_ADMIN_TOKEN: Secret token required via X-Eval-Admin-Token or Authorization: Bearer <token>
# (verified with constant-time comparison) when EVAL_ENABLED="true".
EVAL_ADMIN_TOKEN=""

# RATE_LIMIT_PER_MINUTE: Maximum recommendation requests per IP per minute (default: 10).
RATE_LIMIT_PER_MINUTE="10"

# GLOBAL_RATE_LIMIT_PER_MINUTE: Maximum aggregate recommendation requests across all IPs per minute (default: 60).
GLOBAL_RATE_LIMIT_PER_MINUTE="60"

# DAILY_GEMINI_CALL_BUDGET: Global daily limit on live Gemini API calls before the cost-protection
# circuit breaker trips and returns a friendly 503 state (default: 250).
DAILY_GEMINI_CALL_BUDGET="250"

# TRUST_PROXY_HOPS: Number of trusted reverse-proxy hops (Cloud Run = 1) when reading X-Forwarded-For.
TRUST_PROXY_HOPS="1"

# SHUTDOWN_TIMEOUT_MS: Maximum drain time (ms) on SIGTERM/SIGINT before process exit (default: 10000).
SHUTDOWN_TIMEOUT_MS="10000"

# CORS_ALLOWED_ORIGINS: Comma-separated list of allowed external origins (empty = same-origin only by default).
CORS_ALLOWED_ORIGINS=""

# BOT_PROTECTION_PROVIDER: Optional bot challenge provider ("off" | "turnstile" | "hcaptcha", default: "off").
BOT_PROTECTION_PROVIDER="off"

# BOT_PROTECTION_SECRET_KEY: Server-side secret key for Cloudflare Turnstile or hCaptcha verification.
BOT_PROTECTION_SECRET_KEY=""

# NEXT_PUBLIC_BOT_PROTECTION_SITE_KEY: Public site key for Turnstile or hCaptcha widget (optional).
NEXT_PUBLIC_BOT_PROTECTION_SITE_KEY=""

# ENFORCE_PRODUCTION_CSP_FRAME_ANCESTORS: Set to "true" on standalone production domains to enforce
# "frame-ancestors 'none'" in CSP (kept "false" in AI Studio preview iframe).
ENFORCE_PRODUCTION_CSP_FRAME_ANCESTORS="false"
