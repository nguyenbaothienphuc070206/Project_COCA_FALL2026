# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
# Configure via the Secrets panel in Google AI Studio.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Model used for query understanding, search grounding, extraction, and explanations.
GEMINI_MODEL="gemini-3.8-flash"

# GEMINI_EMBEDDING_MODEL: Model used for multilingual semantic ranking.
GEMINI_EMBEDDING_MODEL="gemini-embedding-2-preview"

# GOOGLE_BOOKS_API_KEY: Optional API key for Google Books /books/v1/volumes secondary verification & metadata enrichment.
# Configure via the Secrets panel in Google AI Studio.
GOOGLE_BOOKS_API_KEY=""

# OPENLIBRARY_CONTACT_EMAIL: Contact email sent in Open Library User-Agent header ("ShelfPath (<email>)") to unlock 3 req/s rate limit (falls back to 1 req/s when empty).
OPENLIBRARY_CONTACT_EMAIL=""

# MOCK_MODE: Set to "true" to force deterministic verified sample datasets without external API calls, or "false" for live verification pipeline.
MOCK_MODE="false"

# RATE_LIMIT_PER_MINUTE: Maximum recommendation requests per IP per minute (default: 10).
RATE_LIMIT_PER_MINUTE="10"

# GLOBAL_RATE_LIMIT_PER_MINUTE: Maximum aggregate recommendation requests across all IPs per minute (default: 60).
GLOBAL_RATE_LIMIT_PER_MINUTE="60"

# DAILY_GEMINI_CALL_BUDGET: Global daily limit on live Gemini API calls before the cost-protection circuit breaker trips and returns a friendly "busy, try again later" state (default: 250).
DAILY_GEMINI_CALL_BUDGET="250"

# EVAL_ENABLED: Enable or disable the internal /eval Evaluation Lab route and /api/eval/* endpoints (default: "true").
EVAL_ENABLED="true"

# EVAL_ADMIN_TOKEN: Secret token required via X-Eval-Admin-Token or Authorization: Bearer <token> (verified with constant-time comparison) to access /api/eval/* when set.
EVAL_ADMIN_TOKEN=""

# TRUST_PROXY_HOPS: Number of trusted reverse-proxy hops (Cloud Run = 1) when reading X-Forwarded-For for per-IP rate limiting.
TRUST_PROXY_HOPS="1"

# CORS_ALLOWED_ORIGINS: Comma-separated list of allowed external origins (empty = same-origin only by default).
CORS_ALLOWED_ORIGINS=""

# BOT_PROTECTION_PROVIDER: Optional bot challenge provider ("off" | "turnstile" | "hcaptcha", default: "off").
BOT_PROTECTION_PROVIDER="off"

# BOT_PROTECTION_SECRET_KEY: Server-side secret key for Cloudflare Turnstile or hCaptcha verification (only used when BOT_PROTECTION_PROVIDER is not "off").
BOT_PROTECTION_SECRET_KEY=""

# NEXT_PUBLIC_BOT_PROTECTION_SITE_KEY: Public site key for Turnstile or hCaptcha widget (optional, default empty).
NEXT_PUBLIC_BOT_PROTECTION_SITE_KEY=""

# ENFORCE_PRODUCTION_CSP_FRAME_ANCESTORS: Set to "true" on standalone production domains to enforce "frame-ancestors 'none'" in CSP (kept "false" by default in AI Studio so the preview iframe renders).
ENFORCE_PRODUCTION_CSP_FRAME_ANCESTORS="false"

# SITE_URL: Canonical base URL used for <link rel="canonical">, hreflang alternates, OpenGraph URLs, robots.txt, and sitemap.xml.
SITE_URL="http://localhost:3000"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

